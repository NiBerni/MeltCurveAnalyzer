    "name": "AI-Driven PCR Melt Curve Analyzer (Beta-Publish-Ready)",
    "description": "End-to-End REST API Test Suite for the AI-Driven PCR Melt Curve Analyzer LIMS.\n\nFeatures:\n- Automatic JWT token extraction into `{{jwt_token}}` upon login.\n- Automatic variable initialization & UUID chaining (`{{template_identifier}}`, `{{template_uuid}}`, `{{created_user_id}}`, `{{operator_user_id}}`, `{{custom_template_id}}`, `{{run_id}}`, `{{result_id}}`).\n- Full RBAC coverage (`Admin`, `Senior`, `Validator`, `Operator`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Ensure core defaults are always resolved in collectionVariables and never shadowed by empty environment vars",
          "const defaultBaseUrl = pm.collectionVariables.get('base_url') || pm.collectionVariables.get('baseUrl') || 'http://localhost:8000';",
          "pm.collectionVariables.set('base_url', defaultBaseUrl);",
          "pm.collectionVariables.set('baseUrl', defaultBaseUrl);",
          "",
          "const currentTpl = pm.collectionVariables.get('template_identifier');",
          "if (!currentTpl || currentTpl.trim() === '') {",
          "    pm.collectionVariables.set('template_identifier', 'COMPREHENSIVE_MULTIPLEX_V1');",
          "}",
          "",
          "if (pm.environment && pm.environment.name) {",
          "    if (!pm.environment.get('base_url')) pm.environment.set('base_url', defaultBaseUrl);",
          "    if (!pm.environment.get('baseUrl')) pm.environment.set('baseUrl', defaultBaseUrl);",
          "    if (!pm.environment.get('template_identifier')) {",
          "        pm.environment.set('template_identifier', pm.collectionVariables.get('template_identifier'));",
          "    }",
          "}"
        ]
      }
    }
  ],
