      "name": "1. Authentication & Identity",
      "item": [
        {
          "name": "1.1 Login as Admin (admin_master) [Auto-Saves JWT]",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "pm.test('Response contains access_token', function () {",
                  "    pm.expect(jsonData).to.have.property('access_token');",
                  "});",
                  "",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('jwt_token', String(jsonData.access_token));",
                  "    if (pm.environment && pm.environment.name) {",
                  "        pm.environment.set('jwt_token', String(jsonData.access_token));",
                  "    }",
                  "    console.log('Successfully stored Admin JWT into {{jwt_token}}');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_master\",\n  \"password\": \"AdminMasterPassword2026!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates the seeded `admin_master` account and automatically stores the returned `access_token` in `{{jwt_token}}`."
          }
        },
