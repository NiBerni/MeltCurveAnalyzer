      "item": [
        {
          "name": "3.1 List Active Templates (Captures Seeded 6-Channel UUID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const templates = pm.response.json();",
                  "if (Array.isArray(templates) && templates.length > 0) {",
                  "    const seeded = templates.find(t => (t.identifier || t.template_identifier || t.name) === 'COMPREHENSIVE_MULTIPLEX_V1') || templates[0];",
                  "    const tplId = String(seeded.id);",
                  "    const tplIdentifier = String(seeded.identifier || seeded.template_identifier || seeded.name || 'COMPREHENSIVE_MULTIPLEX_V1');",
                  "    pm.collectionVariables.set('template_uuid', tplId);",
                  "    pm.collectionVariables.set('template_identifier', tplIdentifier);",
                  "    if (pm.environment && pm.environment.name) {",
                  "        pm.environment.set('template_uuid', tplId);",
                  "        pm.environment.set('template_identifier', tplIdentifier);",
                  "    }",
                  "    console.log('Captured template_uuid:', tplId, 'and template_identifier:', tplIdentifier);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
