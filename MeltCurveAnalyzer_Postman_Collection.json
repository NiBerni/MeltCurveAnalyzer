    {
      "name": "4. Run Management & Cycler Data Ingestion",
      "item": [
        {
          "name": "4.1 Upload Cycler Run File (Requires GDPR Consent)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Guarantee that {{template_identifier}} is resolved before multipart/form-data serialization",
                  "const tplId = pm.collectionVariables.get('template_identifier') || 'COMPREHENSIVE_MULTIPLEX_V1';",
                  "pm.collectionVariables.set('template_identifier', tplId);",
                  "if (pm.environment && pm.environment.name) {",
                  "    pm.environment.set('template_identifier', tplId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "const resolvedRunId = data.run_id || data.id;",
                  "if (resolvedRunId) {",
                  "    pm.collectionVariables.set('run_id', String(resolvedRunId));",
                  "    if (pm.environment && pm.environment.name) {",
                  "        pm.environment.set('run_id', String(resolvedRunId));",
                  "    }",
                  "    console.log('Captured run_id:', resolvedRunId);",
                  "}",
                  "if (Array.isArray(data.results) && data.results.length > 0) {",
                  "    const escalated = data.results.find(r => r.requires_senior_validation === true);",
                  "    const targetResult = escalated ? escalated : data.results[0];",
                  "    if (targetResult && targetResult.id) {",
                  "        pm.collectionVariables.set('result_id', String(targetResult.id));",
                  "        if (pm.environment && pm.environment.name) {",
                  "            pm.environment.set('result_id', String(targetResult.id));",
                  "        }",
                  "        console.log('Captured result_id for technical validation:', targetResult.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "consent_gdpr_phi",
                  "value": "true",
                  "description": "Mandatory GDPR/PHI anonymization confirmation gate",
                  "type": "text"
                },
                {
                  "key": "template_id",
                  "value": "{{template_identifier}}",
                  "description": "Uses seeded COMPREHENSIVE_MULTIPLEX_V1 template",
                  "type": "text"
                },
                {
                  "key": "file",
                  "description": "Select data/demo_6channel_run.csv or data/roche_run_anonymized.xml",
                  "type": "file",
                  "src": "data/demo_6channel_run.csv"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/runs/upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "runs",
                "upload"
              ]
            }
          }
        },
        {
          "name": "4.2 List All Ingested PCR Runs (GET /api/runs)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const runs = pm.response.json();",
                  "if (!pm.collectionVariables.get('run_id') && Array.isArray(runs) && runs.length > 0) {",
                  "    const latestRunId = String(runs[runs.length - 1].run_id || runs[runs.length - 1].id);",
                  "    pm.collectionVariables.set('run_id', latestRunId);",
                  "    if (pm.environment && pm.environment.name) {",
                  "        pm.environment.set('run_id', latestRunId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/runs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "runs"
              ]
            }
          }
        },
        {
          "name": "4.3 Get Full Run Details, Curves & ML Clusters (GET /api/runs/:id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const runData = pm.response.json();",
                  "if (!pm.collectionVariables.get('result_id') && Array.isArray(runData.samples)) {",
                  "    for (const s of runData.samples) {",
                  "        if (Array.isArray(s.results) && s.results.length > 0) {",
                  "            const fallbackResultId = String(s.results[0].id || s.results[0].result_id);",
                  "            pm.collectionVariables.set('result_id', fallbackResultId);",
                  "            if (pm.environment && pm.environment.name) {",
                  "                pm.environment.set('result_id', fallbackResultId);",
                  "            }",
                  "            break;",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/runs/{{run_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "runs",
                "{{run_id}}"
              ]
            }
          }
        }
